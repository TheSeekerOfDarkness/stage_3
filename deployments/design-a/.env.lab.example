# Copy to .env on each physical lab host running Design A
WORKER_ID=lab-pc1-w1
HOST_NAME=lab-pc1
HOST_IP=192.168.1.101
PORT=7000
WORKER_ROLES=ingest,index,search
CRAWL_THREADS=2
INDEX_THREADS=2
SEARCH_THREADS=8

# Coordinator / Infrastructure machine IP
CONSUL_URL=http://192.168.1.100:8500
RABBITMQ_HOST=192.168.1.100
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
MINIO_ENDPOINT=http://192.168.1.100:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
PUBLISH_INTERVAL_MS=1000
MIN_REQUIRED_INDEX_VERSION=0

# Optional deterministic local corpus mirror URL template
GUTENBERG_URL_TEMPLATE=http://192.168.1.100:8900/books/%d
JAVA_OPTS=-Xms256m -Xmx1024m
